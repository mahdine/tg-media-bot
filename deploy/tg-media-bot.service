[Unit]
Description=Telegram media downloader bot
After=network-online.target
Wants=network-online.target

[Service]
# adjust these two paths to your server
WorkingDirectory=/opt/tg-media-bot/bot
ExecStart=/usr/local/bin/bun bot.ts
Restart=always
RestartSec=5
EnvironmentFile=/opt/tg-media-bot/bot/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=YTDLP_UPDATE=off

[Install]
WantedBy=multi-user.target
