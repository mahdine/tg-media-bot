# ============================================================
#  Config for the Telegram media downloader bot (bot/.env)
#  bun automatically loads it when you run:  bun bot.ts
#  Copy this file to bot/.env and fill in the values.
# ============================================================

# --- REQUIRED ------------------------------------------------
# Your bot token from @BotFather (the only thing you MUST fill in)
TOKEN=

# --- OPTIONAL ------------------------------------------------

# Local Bot API server base URL.
#   Blank = official https://api.telegram.org  (50 MB per file)
#   http://127.0.0.1:8081 = local server       (2000 MB per file)
#BOT_API_URL=

# Admin Telegram user id (a number) to DM if the YouTube login/cookies die.
#ADMIN_ID=

# Chat the bot uses to stage guest-mode uploads. Blank = falls back to ADMIN_ID.
#STORAGE_CHAT=

# Where the SQLite cache (bot.sqlite) lives. Blank = ./data
#DATA_DIR=

# How many videos to download at once. Blank = 8
#MAX_DOWNLOADS=

# Stats endpoint port. Blank = 8080
#STATS_PORT=

# Netscape cookies file for a logged-in YouTube session (private/age-gated).
# Blank = /cookies.txt (skipped if it doesn't exist).
#COOKIES=

# Pin the installed yt-dlp (no startup/daily self-update). Recommended for
# self-hosted installs that use a standalone binary.
YTDLP_UPDATE=off
