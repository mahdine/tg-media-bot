# ============================================================
#  tg-media-bot config (Docker)
#  Copy to .env and fill in, then:  docker compose up -d
#  One file feeds BOTH services (bot + local Bot API server).
# ============================================================

# --- REQUIRED (bot) ------------------------------------------
# Your bot token from @BotFather
TOKEN=

# --- REQUIRED (local Bot API server → 2GB uploads) -----------
# From https://my.telegram.org → "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- OPTIONAL (bot) ------------------------------------------

# Where the SQLite cache (bot.sqlite) lives. Blank = ./data
#DATA_DIR=

# How many videos to download at once. Blank = 8
#MAX_DOWNLOADS=

# Stats endpoint port. Blank = 8080
#STATS_PORT=

# Admin Telegram user id (a number) to DM if the YouTube login/cookies die.
#ADMIN_ID=

# Chat the bot uses to stage guest-mode uploads. Blank = falls back to ADMIN_ID.
#STORAGE_CHAT=

# Netscape cookies file (mounted into the container) for a logged-in YouTube
# session (private/age-gated). Blank = /cookies.txt (skipped if missing).
#COOKIES=

# Pin the installed yt-dlp (no startup/daily self-update). Recommended.
YTDLP_UPDATE=off
